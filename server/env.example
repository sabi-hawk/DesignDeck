# ============================================
# DesignDeck Backend Server Environment Variables
# ============================================
# Copy this file to config.env for local development
# For production deployment, set these in your hosting platform's environment variables

# Server Configuration
PORT=3001

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?options
# Get your connection string from MongoDB Atlas or your MongoDB provider
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/designdeck?retryWrites=true&w=majority

# JWT Authentication
# Generate a strong random secret key for production
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Environment
# Set to 'production' for production deployment
NODE_ENV=development

# Frontend URL (for CORS)
# Set this to your deployed frontend URL in production
# For local development: http://localhost:4200
# For Vercel deployment: https://your-project.vercel.app
FRONTEND_URL=http://localhost:4200


