{
  "extends": [
    "plugin:@nx/react",
    "../../.eslintrc.json"
  ],
  "ignorePatterns": [
    "!**/*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {
        "react/jsx-sort-props": [
          "error",
          {
            "callbacksLast": true,
            "shorthandFirst": true,
            "reservedFirst": true
          }
        ]
      }
    }
  ]
}
